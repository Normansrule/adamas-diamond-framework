VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS DATABASE MICRONS 1000 ; END UNITS
MANUFACTURINGGRID 0.005 ;
SITE core CLASS CORE ; SIZE 2.0 BY 30.0 ; SYMMETRY Y ; END core
LAYER GATE TYPE ROUTING ; DIRECTION VERTICAL ; PITCH 4 ; WIDTH 2 ; SPACING 2 ; END GATE
LAYER VIA CUT ; END VIA
LAYER METAL2 TYPE ROUTING ; DIRECTION HORIZONTAL ; PITCH 4 ; WIDTH 2 ; SPACING 2 ; END METAL2
VIA GATE_METAL2 DEFAULT LAYER GATE ; RECT -1 -1 1 1 ; LAYER VIA ; RECT -1 -1 1 1 ; LAYER METAL2 ; RECT -1 -1 1 1 ; END GATE_METAL2
MACRO BUF
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 20.0 BY 30.0 ;
  SYMMETRY X Y ;
  SITE core ;
  PIN A DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 4 25 6 27 ; END
  END A
  PIN Y DIRECTION OUTPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 14.0 25 16.0 27 ; END
  END Y
  PIN VDD DIRECTION INOUT ; USE POWER ;
    PORT LAYER METAL2 ; RECT 0 27.0 20.0 30.0 ; END
  END VDD
  PIN VSS DIRECTION INOUT ; USE GROUND ;
    PORT LAYER METAL2 ; RECT 0 0 20.0 3 ; END
  END VSS
  OBS LAYER GATE ; RECT 2 4 18.0 24 ; END
END BUF
MACRO INV
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 14.0 BY 30.0 ;
  SYMMETRY X Y ;
  SITE core ;
  PIN A DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 4 25 6 27 ; END
  END A
  PIN Y DIRECTION OUTPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 8.0 25 10.0 27 ; END
  END Y
  PIN VDD DIRECTION INOUT ; USE POWER ;
    PORT LAYER METAL2 ; RECT 0 27.0 14.0 30.0 ; END
  END VDD
  PIN VSS DIRECTION INOUT ; USE GROUND ;
    PORT LAYER METAL2 ; RECT 0 0 14.0 3 ; END
  END VSS
  OBS LAYER GATE ; RECT 2 4 12.0 24 ; END
END INV
MACRO NAND2
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 20.0 BY 30.0 ;
  SYMMETRY X Y ;
  SITE core ;
  PIN A DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 4 25 6 27 ; END
  END A
  PIN B DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 15 25 17 27 ; END
  END B
  PIN Y DIRECTION OUTPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 14.0 25 16.0 27 ; END
  END Y
  PIN VDD DIRECTION INOUT ; USE POWER ;
    PORT LAYER METAL2 ; RECT 0 27.0 20.0 30.0 ; END
  END VDD
  PIN VSS DIRECTION INOUT ; USE GROUND ;
    PORT LAYER METAL2 ; RECT 0 0 20.0 3 ; END
  END VSS
  OBS LAYER GATE ; RECT 2 4 18.0 24 ; END
END NAND2
