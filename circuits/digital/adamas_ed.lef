MACRO NOR3
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 26.0 BY 30.0 ;
  SYMMETRY X Y ;
  SITE core ;
  PIN A DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 4 25 6 27 ; END
  END A
  PIN B DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 15 25 17 27 ; END
  END B
  PIN C DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 26 25 28 27 ; END
  END C
  PIN Y DIRECTION OUTPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 20.0 25 22.0 27 ; END
  END Y
  PIN VDD DIRECTION INOUT ; USE POWER ;
    PORT LAYER METAL2 ; RECT 0 27.0 26.0 30.0 ; END
  END VDD
  PIN VSS DIRECTION INOUT ; USE GROUND ;
