MACRO DFF
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 80.0 BY 30.0 ;
  SYMMETRY X Y ;
  SITE core ;
  PIN D DIRECTION INPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 4 25 6 27 ; END
  END D
  PIN CLK DIRECTION INPUT ; USE CLOCK ;
    PORT LAYER METAL2 ; RECT 16 25 18 27 ; END
  END CLK
  PIN Q DIRECTION OUTPUT ; USE SIGNAL ;
    PORT LAYER METAL2 ; RECT 74.0 25 76.0 27 ; END
  END Q
  PIN VDD DIRECTION INOUT ; USE POWER ;
    PORT LAYER METAL2 ; RECT 0 27.0 80.0 30.0 ; END
  END VDD
  PIN VSS DIRECTION INOUT ; USE GROUND ;
    PORT LAYER METAL2 ; RECT 0 0 80.0 3 ; END
  END VSS
  OBS LAYER GATE ; RECT 2 4 78.0 24 ; END
END DFF
END LIBRARY
