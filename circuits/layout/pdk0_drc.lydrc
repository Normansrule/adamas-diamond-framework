# ADAMAS-PDK-0 design-rule check for KLayout (Tools > DRC > Run).  lambda = 1 um; rules from docs/expert/E2.
source($input)
report("ADAMAS PDK-0 DRC")
ohmic = input(1, 0); iso = input(2, 0); enh = input(3, 0); gate = input(4, 0); via = input(5, 0); m2 = input(6, 0); qimp = input(7, 0)
ohmic.width(2.um).output("OHMIC.W", "OHMIC width < 2 um")
ohmic.space(2.um).output("OHMIC.S", "OHMIC space < 2 um")
gate.width(2.um).output("GATE.W", "GATE length < 2 um")
gate.space(2.um).output("GATE.S", "GATE space < 2 um")
m2.width(2.um).output("M2.W", "METAL2 width < 2 um")
m2.space(2.um).output("M2.S", "METAL2 space < 2 um")
gate.separation(ohmic, 2.um).output("GATE.OHMIC", "GATE to OHMIC < 2 um")
via.width(3.um).output("VIA.W", "VIA smaller than 3 um")
via.not_inside(m2.sized(-1.um)).output("VIA.ENC", "VIA not enclosed by METAL2 by 1 um")
qimp.width(0.02.um).output("QIMP.W", "implant aperture < 20 nm")
qimp.not_inside(iso).output("QIMP.ISO", "NV aperture outside an oxygen-terminated window")
