 "odmr": {
  "lab": "labs/lattice.html",
  "title": "Where the magnetic-resonance lines sit",
  "python": "adamas.nv.lines_perturbative_mhz",
  "html": "<i>f</i><sub>±</sub> = <button class=\"v\" type=\"button\" data-k=\"D\"><i>D</i></button> + <span class=\"fr\"><span>3<i>b</i><sub>⊥</sub><sup>2</sup></span><span>2<button class=\"v\" type=\"button\" data-k=\"D\"><i>D</i></button></span></span> ± √(<i>b</i><sub>∥</sub><sup>2</sup> + (<span class=\"fr\"><span><i>b</i><sub>⊥</sub><sup>2</sup></span><span>2<button class=\"v\" type=\"button\" data-k=\"D\"><i>D</i></button></span></span>)<sup>2</sup>), &nbsp; <i>b</i><sub>∥</sub> = γ<sub>e</sub><button class=\"v\" type=\"button\" data-k=\"B\"><i>B</i></button> cos <button class=\"v\" type=\"button\" data-k=\"th\">θ</button>, <i>b</i><sub>⊥</sub> = γ<sub>e</sub><button class=\"v\" type=\"button\" data-k=\"B\"><i>B</i></button> sin <button class=\"v\" type=\"button\" data-k=\"th\">θ</button>",
  "result": {
   "sym": "Δf",
   "name": "splitting of the two lines of the NV along [111]",
   "unit": "MHz",
   "digits": 1
  },
  "vars": {
   "B": {
    "sym": "B",
    "name": "field magnitude",
    "unit": "mT",
    "min": 0,
    "max": 8,
    "digits": 2,
    "src": "the magnet (experiment A2: a magnet's dipole field)"
   },
   "th": {
    "sym": "θ",
    "name": "angle between the field and the [111] NV axis",
    "unit": "°",
    "derived": true,
    "digits": 1,
    "src": "set by the lab's field direction"
   },
   "D": {
    "sym": "D",
    "name": "zero-field splitting",
    "unit": "MHz",
    "min": 2860,
    "max": 2880,
    "digits": 1,
    "src": "2870 MHz at 300 K, −74.2 kHz/K [acosta2010] [doherty2013]"
   }
  },
  "units": [
   "γₑ = 28.03 MHz/mT, so γₑB is in MHz",
   "b²/D: MHz²/MHz = MHz"
  ],
  "assumptions": [
   {
    "id": "weak",
    "text": "second order in B: γₑB ≪ D (the ±1 pair mixes near 90°)"
   },
   {
    "id": "strainfree",
    "text": "no strain or electric field (E = 0)"
   }
  ],
  "refs": [
   "doherty2013",
   "acosta2010"
  ],
  "derivation": [
   "Chapter 6",
   "docs/06_nv_center_physics.md"
  ]
 },
