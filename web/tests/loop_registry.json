 "crystal": {
  "lab": "labs/wafer.html",
  "title": "Crystal quality sets the breakdown field",
  "python": "adamas.power.critical_field_mv_cm",
  "html": "<i>E</i><sub>c</sub> = 7.7 − 1.88 log<sub>10</sub>(<span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"D\">D</button></span><span>10<sup>4</sup> cm<sup>−2</sup></span></span>) MV/cm, &nbsp; <button class=\"v\" type=\"button\" data-k=\"t2\"><i>T</i><sub>2</sub>*</button> ≤ <span class=\"fr\"><span>1</span><span>π <i>k</i><sub>s</sub> <button class=\"v\" type=\"button\" data-k=\"eps\">ε</button>(<button class=\"v\" type=\"button\" data-k=\"D\">D</button>)</span></span>",
  "result": {
   "sym": "E_c",
   "name": "effective breakdown field (proposed fit, floored at 1 MV/cm)",
   "unit": "MV/cm",
   "digits": 2
  },
  "vars": {
   "D": {
    "sym": "D",
    "name": "threading-dislocation density",
    "unit": "cm⁻²",
    "min": 10,
    "max": 1000000000.0,
    "log": true,
    "digits": 2,
    "src": "substrate class: HPHT ~10², CVD on HPHT ~10⁴, heteroepitaxial ~2×10⁷ [stehl2013]"
   },
   "eps": {
    "sym": "ε",
    "name": "strain at the mean dislocation distance, b/(2πr)",
    "unit": "",
    "derived": true,
    "digits": 2,
    "src": "Burgers vector 0.252 nm, r = 1/(2√D)"
   },
   "t2": {
    "sym": "T₂*",
    "name": "strain-limited dephasing time (upper bound)",
    "unit": "µs",
    "derived": true,
    "digits": 3,
    "src": "spin–strain coupling 10.9 GHz per unit strain [marshall2022]"
   }
  },
  "units": [
   "log of a ratio of densities",
   "GHz × strain × µs: dimensionless"
  ],
  "assumptions": [
   {
    "id": "fit",
    "text": "E_c(D) is an engineering fit, not a law"
   },
   {
    "id": "range",
    "text": "fit range 10⁴ to 10⁸ cm⁻²"
   }
  ],
  "refs": [
   "volpe2010",
   "kwak2021",
   "weippert2022",
