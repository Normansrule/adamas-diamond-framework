 "ring": {
  "lab": "labs/transistor.html",
  "title": "A hand estimate of the ring oscillator",
  "python": "adamas.logic.ring_period_estimate_s",
  "html": "<i>T</i> = <button class=\"v\" type=\"button\" data-k=\"N\"><i>N</i></button> (<span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"C\"><i>C</i></button><button class=\"v\" type=\"button\" data-k=\"V\"><i>V</i><sub>DD</sub></button></span><span>2<button class=\"v\" type=\"button\" data-k=\"IL\"><i>I</i><sub>L</sub></button></span></span> + <span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"C\"><i>C</i></button><button class=\"v\" type=\"button\" data-k=\"V\"><i>V</i><sub>DD</sub></button></span><span>2(<button class=\"v\" type=\"button\" data-k=\"ID\"><i>I</i><sub>D</sub></button> − <button class=\"v\" type=\"button\" data-k=\"IL\"><i>I</i><sub>L</sub></button>)</span></span>), &nbsp; <i>I</i> ∝ <button class=\"v\" type=\"button\" data-k=\"mu\">μ</button>",
  "result": {
   "sym": "T",
   "name": "estimated period of the five-stage ring",
   "unit": "ns",
