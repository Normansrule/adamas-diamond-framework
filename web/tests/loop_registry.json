{
 "rabi": {
  "lab": "labs/qubit.html",
  "title": "Rabi oscillation",
  "python": "adamas.nv.rabi",
  "html": "<i>P</i><sub>−1</sub> = <span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"Om\">Ω</button><sup>2</sup></span><span><button class=\"v\" type=\"button\" data-k=\"Om\">Ω</button><sup>2</sup> + <button class=\"v\" type=\"button\" data-k=\"de\">δ</button><sup>2</sup></span></span> sin<sup>2</sup>(π√(<button class=\"v\" type=\"button\" data-k=\"Om\">Ω</button><sup>2</sup> + <button class=\"v\" type=\"button\" data-k=\"de\">δ</button><sup>2</sup>) <button class=\"v\" type=\"button\" data-k=\"t\">t</button>)",
  "result": {
   "sym": "P₋₁",
   "name": "probability of mₛ = −1 after the pulse",
   "unit": "",
   "digits": 3
  },
  "vars": {
   "Om": {
    "sym": "Ω",
    "name": "Rabi frequency",
    "unit": "MHz",
    "min": 1,
    "max": 20,
    "digits": 1,
    "src": "set by microwave power; the π pulse lasts 1/(2Ω)"
   },
   "de": {
    "sym": "δ",
    "name": "detuning",
    "unit": "MHz",
    "min": -4,
    "max": 4,
    "digits": 2,
    "src": "microwave frequency minus the ODMR line (experiment A1)"
   },
   "t": {
    "sym": "t",
    "name": "pulse length",
    "unit": "µs",
    "min": 0,
    "max": 2,
    "digits": 3,
    "src": "pulse generator (experiment B1)"
   }
  },
  "units": [
   "MHz × µs = 1: the phase is dimensionless"
  ],
  "assumptions": [
   {
    "id": "rwa",
    "text": "rotating wave: Ω ≪ D = 2870 MHz"
   },
   {
    "id": "nodecay",
    "text": "no decay: t ≪ T₂*"
   },
   {
    "id": "twolevel",
    "text": "two levels: mₛ = 0 and −1 only"
   }
  ],
  "refs": [
   "rabi1937",
   "jelezko2004a"
  ],
  "derivation": [
   "Chapter 6",
   "docs/06_nv_center_physics.md"
  ]
 },
 "ramsey": {
  "lab": "labs/qubit.html",
  "title": "Ramsey fringes",
  "python": "adamas.nv.ramsey",
  "html": "<i>P</i><sub>−1</sub> = ½[1 + cos(2π<button class=\"v\" type=\"button\" data-k=\"de\">δ</button><button class=\"v\" type=\"button\" data-k=\"tau\">τ</button>) e<sup>−(<button class=\"v\" type=\"button\" data-k=\"tau\">τ</button>/<button class=\"v\" type=\"button\" data-k=\"t2s\">T<sub>2</sub>*</button>)<sup>2</sup></sup>]",
  "result": {
   "sym": "P₋₁",
   "name": "probability of mₛ = −1 after π/2 – τ – π/2",
   "unit": "",
   "digits": 3
  },
  "vars": {
   "de": {
    "sym": "δ",
    "name": "detuning",
    "unit": "MHz",
    "min": -4,
    "max": 4,
    "digits": 2,
    "src": "microwave frequency minus the ODMR line"
   },
   "tau": {
    "sym": "τ",
    "name": "free time",
    "unit": "µs",
    "min": 0,
    "max": 6,
    "digits": 2,
    "src": "pulse generator"
   },
   "t2s": {
    "sym": "T₂*",
    "name": "dephasing time",
    "unit": "µs",
    "min": 0.1,
    "max": 6,
    "digits": 2,
    "src": "spread of static detunings; 1 to 100 µs in real diamond [balasubramanian2009]"
   }
  },
  "units": [
   "MHz × µs = 1",
   "τ / T₂* is dimensionless"
  ],
  "assumptions": [
   {
    "id": "hard",
    "text": "hard pulses: π/(2Ω) ≪ τ"
   },
   {
    "id": "gauss",
    "text": "quasi-static Gaussian detunings"
   }
  ],
  "refs": [
   "ramsey1950",
   "degen2017"
  ],
  "derivation": [
   "Chapter 6",
   "docs/06_nv_center_physics.md"
  ]
 },
 "echo": {
  "lab": "labs/qubit.html",
  "title": "Hahn echo with a mistimed π pulse",
  "python": "adamas.nv.echo_mistimed",
  "html": "<i>P</i><sub>−1</sub> = ½[1 − cos(2π<button class=\"v\" type=\"button\" data-k=\"de\">δ</button><button class=\"v\" type=\"button\" data-k=\"eps\">ε</button>) e<sup>−(<button class=\"v\" type=\"button\" data-k=\"eps\">ε</button>/<button class=\"v\" type=\"button\" data-k=\"t2s\">T<sub>2</sub>*</button>)<sup>2</sup></sup>], &nbsp; ε = τ<sub>2</sub> − τ<sub>1</sub>",
  "result": {
   "sym": "P₋₁",
   "name": "probability of mₛ = −1 after π/2 – τ₁ – π – τ₂ – π/2",
   "unit": "",
   "digits": 3
  },
  "vars": {
   "de": {
    "sym": "δ",
    "name": "detuning",
    "unit": "MHz",
    "min": -4,
    "max": 4,
    "digits": 2,
    "src": "microwave frequency minus the ODMR line"
   },
   "eps": {
    "sym": "ε",
    "name": "π-pulse mistiming τ₂ − τ₁",
    "unit": "µs",
    "min": -2,
    "max": 2,
    "digits": 2,
    "src": "pulse placement; 0 for a centred echo"
   },
   "t2s": {
    "sym": "T₂*",
    "name": "dephasing time",
    "unit": "µs",
    "min": 0.1,
    "max": 6,
    "digits": 2,
    "src": "spread of static detunings"
   }
  },
  "units": [
   "MHz × µs = 1"
  ],
  "assumptions": [
   {
    "id": "static",
    "text": "static noise only: real spins also lose T₂ (not modelled here)"
   },
   {
    "id": "hard",
    "text": "hard pulses"
   }
  ],
  "refs": [
   "hahn1950",
   "delange2010"
  ],
  "derivation": [
   "Chapter 6",
   "docs/06_nv_center_physics.md"
  ]
 },
 "contrast": {
  "lab": "labs/photon.html",
  "title": "Readout contrast you can measure",
  "python": "adamas.photophysics.measured_contrast",
  "html": "<i>C</i> = 1 − <span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"P\"><i>P</i></button> <i>I</i><sub>1</sub> + (1 − <button class=\"v\" type=\"button\" data-k=\"P\"><i>P</i></button>) <i>I</i><sub>0</sub></span><span><button class=\"v\" type=\"button\" data-k=\"P\"><i>P</i></button> <i>I</i><sub>0</sub> + (1 − <button class=\"v\" type=\"button\" data-k=\"P\"><i>P</i></button>) <i>I</i><sub>1</sub></span></span>, &nbsp; <i>I</i><sub>m</sub> = ∫<sub>0</sub><sup><button class=\"v\" type=\"button\" data-k=\"win\">t<sub>w</sub></button></sup> photons(mₛ = m), &nbsp; <button class=\"v\" type=\"button\" data-k=\"P\"><i>P</i></button>(<button class=\"v\" type=\"button\" data-k=\"beta\">β</button>, <button class=\"v\" type=\"button\" data-k=\"tpol\">t<sub>pol</sub></button>)",
  "result": {
   "sym": "C",
   "name": "contrast with and without a π pulse, from the pumped state",
   "unit": "",
   "digits": 3
  },
  "vars": {
   "beta": {
    "sym": "β",
    "name": "pump rate over the radiative rate",
    "unit": "",
    "min": 0.1,
    "max": 3,
    "digits": 2,
    "src": "laser power; saturation near 1 [tetienne2012]"
   },
   "win": {
    "sym": "t_w",
    "name": "counting window",
    "unit": "µs",
    "min": 0.1,
    "max": 1,
    "digits": 2,
    "src": "photon-counter gate"
   },
   "tpol": {
    "sym": "t_pol",
    "name": "pumping time before the pulse",
    "unit": "µs",
    "min": 0.3,
    "max": 5,
    "digits": 1,
    "src": "laser pulse length"
   },
   "P": {
    "sym": "P",
    "name": "spin polarization (population of mₛ = 0)",
    "unit": "",
    "derived": true,
    "digits": 3,
    "src": "computed from the rate model after t_pol"
   }
  },
  "units": [
   "rates in 1/µs × times in µs: dimensionless"
  ],
  "assumptions": [
   {
    "id": "zerofield",
    "text": "zero field: mₛ = ±1 lumped"
   },
   {
    "id": "perfectpi",
    "text": "perfect π pulse"
   },
   {
    "id": "window",
    "text": "window shorter than the singlet lifetime (≈ 0.5 µs)"
   }
  ],
  "refs": [
   "tetienne2012",
   "gruber1997"
  ],
  "derivation": [
   "Chapter 6",
   "docs/06_nv_center_physics.md"
  ]
 },
 "hot_switch": {
