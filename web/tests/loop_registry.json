 "crosstalk": {
  "lab": "labs/addressing.html",
  "title": "Driving one NV without the other",
  "python": "adamas.addressing.crosstalk",
  "html": "<i>X</i> = <span class=\"fr\"><span><button class=\"v\" type=\"button\" data-k=\"Om\">Ω</button><sup>2</sup></span><span><button class=\"v\" type=\"button\" data-k=\"Om\">Ω</button><sup>2</sup> + <button class=\"v\" type=\"button\" data-k=\"Dl\">Δ</button><sup>2</sup></span></span>, &nbsp; resolved if <button class=\"v\" type=\"button\" data-k=\"Dl\">Δ</button> &gt; <span class=\"fr\"><span>2√ln 2</span><span>π<button class=\"v\" type=\"button\" data-k=\"t2s\">T<sub>2</sub>*</button></span></span>",
  "result": {
   "sym": "X",
   "name": "peak excitation of the other NV (crosstalk)",
   "unit": "",
   "digits": 4
  },
  "vars": {
   "Om": {
    "sym": "Ω",
    "name": "Rabi frequency of the drive",
    "unit": "MHz",
    "min": 0.1,
    "max": 20,
    "digits": 2,
    "src": "microwave power"
   },
   "Dl": {
    "sym": "Δ",
    "name": "separation of the two NVs' lines",
    "unit": "MHz",
    "derived": true,
    "digits": 2,
    "src": "orientation (spectral route) or field gradient"
   },
   "t2s": {
    "sym": "T₂*",
    "name": "dephasing time",
    "unit": "µs",
    "min": 0.2,
    "max": 50,
    "digits": 1,
    "src": "sets the line width 2√ln2/(πT₂*) of a Gaussian free-induction decay"
   }
  },
  "units": [
   "MHz² / MHz²: dimensionless",
   "1/(µs) = MHz"
  ],
  "assumptions": [
   {
    "id": "resolved",
    "text": "lines resolved: Δ above the line width"
   },
   {
    "id": "nohf",
    "text": "¹⁴N hyperfine ignored (2.15 MHz triplet)"
   }
  ],
  "refs": [
   "rabi1937",
   "dolde2013",
   "grinolds2011"
  ],
  "derivation": [
   "Chapter 7",
   "docs/07_nv_fabrication_and_placement.md"
  ]
